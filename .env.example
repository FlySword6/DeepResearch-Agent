# =============================================================================
# DeepResearch-Agent Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# ---------------------------------------------------------------------------
# LLM API Keys (choose at least one)
# ---------------------------------------------------------------------------
# OpenAI API Key (supports GPT-4o, GPT-4-turbo, etc.)
# Required if provider is "openai"
OPENAI_API_KEY=

# Anthropic API Key (supports Claude 3.5 Sonnet, Claude 3 Opus, etc.)
# Required if provider is "anthropic"
ANTHROPIC_API_KEY=

# DashScope API Key (for Alibaba Cloud embedding models)
# Optional — only needed for DashScope embeddings
DASHSCOPE_API_KEY=

# ---------------------------------------------------------------------------
# Model Selection — specify models for different agents
# ---------------------------------------------------------------------------
LLM_MODEL_PLANNER=gpt-4o
LLM_MODEL_RESEARCHER=gpt-4o
LLM_MODEL_WRITER=gpt-4o
LLM_MODEL_REVIEWER=gpt-4o

# ---------------------------------------------------------------------------
# Search API
# ---------------------------------------------------------------------------
# Search backends: comma-separated list, supported values: tavily, duckduckgo, github, exa
SEARCH_API_PROVIDER=tavily
SEARCH_BACKENDS=tavily,duckduckgo,github

# Tavily Search API Key (https://tavily.com)
# Optional — search falls back to DuckDuckGo (free) + GitHub if not set
TAVILY_API_KEY=

# Exa Search API Key (optional)
EXA_API_KEY=

# GitHub Token (for GitHub code search, optional)
# Creates a personal token at https://github.com/settings/tokens (no scopes needed)
# Without this, GitHub search still works but with a lower rate limit (60 req/hr)
GITHUB_TOKEN=

# Development only. false means failed searches are reported clearly instead of using mock data.
ENABLE_MOCK_SEARCH=false

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Redis connection URL (for caching and session management; leave empty for in-memory)
REDIS_URL=redis://localhost:6379/0

# ChromaDB vector database persistence path
CHROMA_DB_PATH=./data/chroma_db

# Hybrid RAG persistence and retrieval tuning
RAG_INDEX_PATH=./data/rag_index
# Vector backend: "milvus" for production, "chroma" for local fallback, "auto" to try Milvus first
RAG_VECTOR_BACKEND=milvus
RAG_PARENT_CHUNK_SIZE=1800
RAG_PARENT_CHUNK_OVERLAP=200
RAG_CHILD_CHUNK_SIZE=512
RAG_CHILD_CHUNK_OVERLAP=64
RAG_VECTOR_TOP_K=20
RAG_BM25_TOP_K=20
RAG_RRF_K=60

# Milvus vector backend. For docker-compose use http://milvus:19530 inside the app container.
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=research_knowledge
MILVUS_METRIC_TYPE=COSINE
MILVUS_CONSISTENCY_LEVEL=Bounded
MILVUS_TEXT_MAX_LENGTH=16384
MILVUS_METADATA_MAX_LENGTH=8192
MILVUS_QUERY_LIMIT=10000

# Workflow engine: "langgraph" keeps the original graph, "harness" uses the Harness Agent Runtime adapter
WORKFLOW_ENGINE=langgraph

# Query router: simple questions use direct web search, research-like questions use multi-agent workflow
QUERY_ROUTER_ENABLED=true
DIRECT_SEARCH_MAX_RESULTS=5
MULTI_AGENT_ROUTE_MIN_LENGTH=180
# Optional comma-separated override. Empty means using built-in Chinese/English research keywords.
MULTI_AGENT_ROUTE_KEYWORDS=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
